# ECDAT — environment configuration template
# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Core (required by the task spec) ---------------------------------

# MongoDB connection string used by the backend service.
# Example: mongodb://ecdat_user:changeme@mongo:27017/ecdat?authSource=admin
MONGO_URI=

# Master secret used to derive/verify per-project HMAC tokens
# (ecdat_<projectId>.<secret>). Generate with: openssl rand -hex 32
PROJECT_SECRET=

# The single allowed browser origin for CORS, and the public domain
# Caddy issues a TLS certificate for. Example: https://ecdat.ntro.gov.in
FRONTEND_URL=

# --- Supporting variables (needed for the compose stack to run) -------

# Root credentials for the mongo container itself.
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# API key for the NVIDIA LLM PQC code-generation service.
NVIDIA_API_KEY=
